#!/bin/sh
#
# git-touching — list the local and origin branches that change a path, relative to the base branch.
#
# Usage: git touching <path>...
#
# A branch is listed when a commit on it that is not on the base branch changes one of the paths.
# They are pathspecs, so a directory or quoted glob works too, and a path that no longer exists in
# the working tree still matches the commits that deleted or renamed it. Origin branches print as
# `origin/<name>` and are as current as the last fetch; nothing here fetches. A branch whose commits
# landed rewritten — rebased, squashed or cherry-picked — is still listed until `git cleanup`
# removes it, because its own commits never reach the base.
#
# "Not on the base branch" means on neither the local base nor origin's copy of it, whichever of the
# two exist. git-base can name a branch that exists only on origin, and excluding both keeps a
# branch merged upstream from being listed just because the local base has not been pulled since.
# Ref names cannot contain whitespace or glob characters, which is what makes `$exclude` safe to
# leave unquoted.
#
# Merges never count, and `--full-history` keeps them from hiding the commits that do. Under the
# default history simplification the answer turned on whether the base had moved since a branch
# last merged it. Once it had, a branch that merged the base was listed for paths only the base
# changed; until it had, a branch commit was hidden by a later merge that took the base's version of
# the path. The cost is that content introduced only by a merge's conflict resolution is not seen.
#
# Usually reached as `git touching`; see git-base for why the ~/.gitconfig entry is a fallback.
# Unlike the other commands here, this one reads its arguments relative to the working directory.
# A dashed external keeps the directory it was invoked from, but the alias runs from the repository
# top level and records the directory it left in GIT_PREFIX — the `cd` returns there. A dashed
# external normally sees GIT_PREFIX unset; one inherited from an enclosing alias is still right
# unless that alias changed directory before calling this. The `./` stops `cd` from searching
# CDPATH, which could land outside the repository and print the directory it chose.
#
# Branches are walked by full ref name, so a tag sharing a branch's name cannot answer for it, and
# printed with the refs/heads/ or refs/remotes/ prefix stripped rather than as `%(refname:short)`,
# which would disambiguate such a branch as `heads/<name>`. origin/HEAD is skipped because it only
# points at another origin branch. A failing walk, such as for a path outside the repository, ends
# the loop rather than repeating the error once per branch.
#
# The branch listing lands in a variable and the loop reads a here-document, for git-cleanup's
# reason: a pipeline reports only its last command's status, so a listing that failed mid-pipe
# would exit 0 with no output, indistinguishable from no branch touching the path.

if [ $# -eq 0 ]; then
  echo 'usage: git touching <path>...' >&2
  exit 1
fi

cd -- "./${GIT_PREFIX}" || exit 1
base=$(git base) || exit 1

exclude=
for ref in "refs/heads/$base" "refs/remotes/origin/$base"; do
  if git rev-parse --verify --quiet "$ref" >/dev/null; then
    exclude="$exclude $ref"
  fi
done

refs=$(git for-each-ref --format='%(refname)' refs/heads refs/remotes/origin) || exit 1

while read -r ref; do
  case $ref in
    '' | refs/remotes/origin/HEAD) continue ;;
  esac

  # shellcheck disable=SC2086  # $exclude splits into refs on purpose; see the header
  commit=$(git rev-list -n 1 --no-merges --full-history "$ref" --not $exclude -- "$@") || exit 1
  if [ -n "$commit" ]; then
    case $ref in
      refs/heads/*) echo "${ref#refs/heads/}" ;;
      *) echo "${ref#refs/remotes/}" ;;
    esac
  fi
done <<EOF
$refs
EOF

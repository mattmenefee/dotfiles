{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "ENABLE_TOOL_SEARCH": "auto:5"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(bin/lint-markdown *)",
      "Bash(bin/rails lint:*)",
      "Bash(bin/rails lint:coffee:*)",
      "Bash(bin/rails lint:haml:*)",
      "Bash(bin/rails lint:markdown:*)",
      "Bash(bin/rails lint:ruby:*)",
      "Bash(bin/rails lint:sass:*)",
      "Bash(bin/rspec:*)",
      "Bash(bin/rubocop:*)",
      "Bash(bundle exec haml-lint:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(git add:*)",
      "Bash(git mv:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(yarn build)",
      "Bash(yarn coffeelint:*)",
      "Bash(yarn stylelint:*)",
      "mcp__appsignal__discover_metrics",
      "mcp__appsignal__get_app_resources",
      "mcp__appsignal__get_applications",
      "mcp__appsignal__get_incident",
      "mcp__appsignal__get_metric_names",
      "mcp__appsignal__get_metric_tags",
      "mcp__appsignal__get_metrics_list",
      "mcp__appsignal__get_metrics_timeseries",
      "mcp__chrome-devtools__close_page",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__new_page",
      "mcp__chrome-devtools__select_page",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__linear-server__get_issue",
      "mcp__linear-server__get_issue_status",
      "mcp__linear-server__get_project",
      "mcp__linear-server__get_team",
      "mcp__linear-server__get_user",
      "mcp__linear-server__list_issue_labels",
      "mcp__linear-server__list_issue_statuses",
      "mcp__linear-server__list_issues",
      "mcp__linear-server__list_project_labels",
      "mcp__linear-server__list_projects",
      "mcp__linear-server__list_teams",
      "mcp__linear-server__list_users",
      "mcp__playwright__playwright_click",
      "mcp__playwright__playwright_close",
      "mcp__playwright__playwright_get_visible_html",
      "mcp__playwright__playwright_hover",
      "mcp__playwright__playwright_navigate",
      "mcp__playwright__playwright_screenshot",
      "mcp__playwright__playwright_upload_file",
      "mcp__rubocop__rubocop_autocorrection",
      "mcp__rubocop__rubocop_inspection",
      "mcp__serena__activate_project",
      "mcp__serena__check_onboarding_performed",
      "mcp__serena__find_file",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__find_symbol",
      "mcp__serena__get_current_config",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__initial_instructions",
      "mcp__serena__insert_after_symbol",
      "mcp__serena__insert_before_symbol",
      "mcp__serena__list_dir",
      "mcp__serena__list_memories",
      "mcp__serena__onboarding",
      "mcp__serena__read_memory",
      "mcp__serena__replace_regex",
      "mcp__serena__replace_symbol_body",
      "mcp__serena__search_for_pattern",
      "mcp__serena__think_about_collected_information",
      "mcp__serena__think_about_whether_you_are_done",
      "mcp__serena__write_memory"
    ],
    "ask": [
      "Bash(git clean:*)",
      "Bash(heroku config*)",
      "Bash(heroku pg*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(aws configure get*)",
      "Bash(bin/cap production*)",
      "Bash(bundle exec cap production*)",
      "Bash(cap production*)",
      "Bash(circleci api*)",
      "Bash(docker-credential-*)",
      "Bash(gh auth*)",
      "Bash(git add --force*)",
      "Bash(git add -f*)",
      "Bash(git credential*)",
      "Bash(git push * production*)",
      "Bash(git push production*)",
      "Bash(heroku auth*)",
      "Bash(heroku config:set*)",
      "Bash(heroku config:unset*)",
      "Bash(heroku pg:credentials*)",
      "Bash(heroku pg:kill*)",
      "Bash(heroku pg:promote*)",
      "Bash(heroku pg:reset*)",
      "Bash(heroku pg:upgrade*)",
      "Bash(heroku run*)",
      "Bash(security find-generic-password*)",
      "Read(//**/.env)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.local)",
      "Read(//**/.env.production)",
      "Read(//**/.env.production.*)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.staging.*)",
      "Read(//**/config/credentials/*.key)",
      "Read(//**/config/master.key)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.ssh/**)",
      "mcp__circleci-cli__circleci_api",
      "mcp__heroku__deploy_one_off_dyno",
      "mcp__heroku__deploy_to_heroku",
      "mcp__heroku__maintenance_off",
      "mcp__heroku__maintenance_on",
      "mcp__heroku__pg_credentials",
      "mcp__heroku__pg_kill",
      "mcp__heroku__pg_psql",
      "mcp__heroku__pg_upgrade",
      "mcp__heroku__pipelines_promote",
      "mcp__heroku__ps_restart",
      "mcp__heroku__ps_scale",
      "mcp__heroku__rename_app"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/iterm2/cc-status"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "code-review@claude-code-plugins": true,
    "explanatory-output-style@claude-code-plugins": true,
    "frontend-design@claude-plugins-official": true,
    "playwright-cli@playwright-cli": true,
    "ruby-lsp@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754089078351
  }
}

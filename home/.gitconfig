[core]
  excludesfile = ~/.gitignore_global
  autocrlf = input
  editor = /opt/homebrew/bin/mvim -v
[alias]
  # base, bdone, com and cleanup are stubs; their bodies are scripts in ~/.local/bin, which is on
  # PATH. Git finds those executables before it reads these entries, so these are the fallback for
  # contexts without that PATH — launch agents, cron, GUI clients — and naming the full path is what
  # makes it work.

  a = commit --amend
  aa = add --all
  ap = add --patch
  br = for-each-ref --sort=committerdate --format=\"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/heads
  branches = branch
  remote-branches = for-each-ref --sort=-committerdate --format=\"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/remotes
  ci = commit -v
  co = checkout
  # Switch to the repository's base branch. Takes no arguments.
  com = "!~/.local/bin/git-com"
  cob = checkout -b
  cp = cherry-pick
  dc = diff --cached
  df = diff
  ec = config --global -e
  g = grep --break --heading --line-number
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  pf = push --force-with-lease
  st = status -s
  wt = worktree list
  undo = reset HEAD~1 --mixed
  up = pull --rebase --prune
  wip = !git add -A && git commit -m "WIP"
  wipe = !git add -A && git commit -qm 'WIPE SAVEPOINT' && git reset HEAD~1 --hard
  stash-all = stash save --include-untracked
  grog = log --graph --abbrev-commit --decorate --all --format=format:\"%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(dim white) - %an%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n %C(white)%s%C(reset)\"
  recent = for-each-ref --count=10 --sort=-committerdate refs/heads/ --format="%(refname:short)"
  rc = rebase --continue

  # A wrapper around `cleanup`, kept for muscle memory. Arguments forward, so `git bclean develop`
  # runs `git cleanup develop`.
  bclean = !git cleanup

  # Post-PR tidy-up: switch to the base branch, pull, then prune what that merged. Optional base.
  bdone = "!~/.local/bin/git-bdone"

  # All refs by most-recent commit; the stale branches are at the bottom of the output.
  springcleaning = for-each-ref --sort=-committerdate --format='%(refname:short) %(committerdate:short)'

  # Print the repository's base branch. Prints nothing and fails when none resolves, so that callers
  # abort rather than guess a name.
  base = "!~/.local/bin/git-base"

  # Delete local branches whose changes already reached the base branch, including ones merged via
  # "Rebase and merge". Optional base. Force-deletes, and has wiped unmerged work before — read the
  # script before changing it, or anything that calls it.
  cleanup = "!~/.local/bin/git-cleanup"

  # Pull the current branch, then prune whatever that merged. Takes the same optional base.
  pc = "!f() { git pull && git cleanup \"$@\"; }; f"

  # list of deleted files:
  # git log --diff-filter=D --summary | grep delete

[commit]
  # "other people can trust that the changes you've made really were made by you"
  # https://help.github.com/articles/about-gpg/
  # https://git-scm.com/docs/git-config#git-config-commitgpgSign
  # gpgSign = true

[credential]
  helper = osxkeychain
[merge]
  ff = only
  tool = diffmerge

  # Standard diff is two sets of final changes. This introduces the original text before each
  # side's changes.
  # https://git-scm.com/docs/git-config#git-config-mergeconflictStyle
  # conflictstyle = diff3

[mergetool "diffmerge"]
  cmd = "diffmerge --merge --result=\"$MERGED\" \"$LOCAL\" \"$(if test -f \"$BASE\"; then echo \"$BASE\"; else echo \"$LOCAL\"; fi)\" \"$REMOTE\""
  trustExitCode = true
[mergetool]
  keepBackup = false
[diff]
  tool = diffmerge
  submodule = log
[difftool "diffmerge"]
  cmd = diffmerge $LOCAL $REMOTE
[fetch]
  prune = true
[push]
  default = current
  autoSetupRemote = true
[pull]
  rebase = true
[color]
  ui = true
[filter "media"]
  required = true
  clean = git media clean %f
  smudge = git media smudge %f
[rebase]
  autosquash = true
[filter "lfs"]
  process = git-lfs filter-process
  required = true
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
[include]
  path = ~/.gitconfig.local
[web]
  browser = open
[grep]
  extendRegexp = true
[rerere]
  enabled = true
[status]
  showUntrackedFiles = all
[init]
  defaultBranch = main
